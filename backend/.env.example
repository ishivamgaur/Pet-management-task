PORT=5000

// Local Mongo, or an Atlas connection string. Always include a database
// name at the end, otherwise the driver connects to a stray "test" db.
MONGO_URI=mongodb://127.0.0.1:27017/pet_adoption

// Change this to a long random string before deploying.
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d

// Only needed when your network resolver rejects SRV lookups, which
// mongodb+srv requires. Leave blank when deploying.
// DNS_SERVERS=8.8.8.8,1.1.1.1

// The admin account is created on boot if it does not already exist.
ADMIN_EMAIL=admin@shelter.com
ADMIN_PASSWORD=admin123